# Root .env: used ONLY by maintenance scripts in supabase/scripts (run on your machine).
# Never put these values in the app or the admin panel.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key: bypasses RLS. Scripts and Edge Functions only. NEVER commit, NEVER ship in an app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test accounts created by `npm run db:test-users` (share with Davi privately, never in git).
TEST_EXPLORER_EMAIL=explorador@example.com
TEST_EXPLORER_PASSWORD=
TEST_EXPLORER2_EMAIL=explorador2@example.com
TEST_EXPLORER2_PASSWORD=
TEST_HOST_EMAIL=anfitrion@example.com
TEST_HOST_PASSWORD=
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=

# Figma export (npm run figma:export). Personal access token, read-only scope. Never commit.
FIGMA_TOKEN=
FIGMA_FILE_KEY=CtMVRpd9MZSD7UxzOELPXC
