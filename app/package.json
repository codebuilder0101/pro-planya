{
  "name": "planya-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "7.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-location": "58.0.20",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" app.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" app.config.ts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "gen:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/types/database.ts",
    "doctor": "npx expo-doctor",
    "preview": "node scripts/design-preview.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
