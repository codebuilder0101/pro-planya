# App environment. Copy to app/.env for local development (gitignored).
# For EAS builds, set the same names as EAS environment variables
# (development / preview / production) in the client's Expo account.

# Public values: they are compiled into the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key ONLY. Never put the service role key in the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Build-time only (read by app.config.ts).
EAS_PROJECT_ID=
# Google Maps SDK for Android key (client's Google Cloud), restricted to the
# Android package name + signing certificate fingerprints.
GOOGLE_MAPS_ANDROID_API_KEY=
